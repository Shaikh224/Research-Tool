# Required: Firecrawl API key (free tier works). Get one at https://firecrawl.dev
FIRECRAWL_API_KEY=fc-your-key-here

# Optional: enables a true second-model critic pass (Google Gemini, free tier).
# Get one at https://aistudio.google.com/apikey  — leave blank to use the
# Firecrawl-only critic (re-extraction + diff), which still runs fully free.
GEMINI_API_KEY=

# --- Tunables (safe defaults; lower to save Firecrawl credits) ---
# How many search results to consider per app when choosing pages to scrape.
SEARCH_LIMIT=5
# Scrape the pricing/signup page too (the self-serve-vs-gated check, Loop B).
RUN_GATE_CHECK=true
# Max apps to process (set e.g. 10 for a cheap test run; 100 for the full set).
MAX_APPS=100
# Parallel workers.
WORKERS=6
